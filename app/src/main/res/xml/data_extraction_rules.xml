<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Never back up or transfer the encrypted Intervals.icu token. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="auth.xml" />
    </device-transfer>
</data-extraction-rules>
